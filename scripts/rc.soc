set rcerror=false
# Метки этапов (2026-10-18): флейк init висит в одном из тихих шагов ниже — метка покажет, в каком.
echo "RC: init soc"
init soc
echo "RC: init misc"
init misc
echo "RC: init mmu"
init mmu
echo "RC: init bcm"
init bcm
echo "RC: init done"
# БЕЗ an=on (2026-10-16): an=on уводил порты в 1G, а обратный переход 1G->10G на WC6+ (клетки 25-48)
# не проходит (MAC Fault(Local)). Порты остаются в дефолтном 10G; SFPScan переводит в 1G только 1G-модули.
port xe enable=true stp=forward
# --- Авто-детект скорости по SFP EEPROM (замена хардкод-форса port xe3,xe18 sp=10000) ---
# SFPScan (наша команда, собрана в bcm.user): читает EEPROM модуля (I2C 0x50) через
# I2C-мастер PHY 84740/84754 и ставит скорость: 10G для 10GbE/DAC, 1G для 1000BASE.
# Порты, уже имеющие нужную скорость, НЕ трогает (линк не дёргается). 'dump' печатает
# ключевые байты SFF-8472 (id/b3/b6/b8/b12) в лог для диагностики.
SFPScan xe0-xe47 dump
# VLAN-раскладка: vlan.soc генерирует box-start из vlan.conf (vlan-gen.sh). Пустой = всё в VLAN 1.
rcload /var/bcm/vlan.soc
linkscan 250000
port xe linkscan=on
# Счётчики портов (2026-10-17): в config bcm_stat_interval=0 (так init стабильнее под real-IRQ),
# поэтому сбор включаем уже после init — как сток, раз в 3с. Без этого `show c` пустой.
# DMA=false (24.10): в режиме гидры (64 порта) DMA-сбор падает «DMA did not finish» -> поток
# счётчиков умирает; без DMA работает в обоих режимах.
counter Interval=3000000 PortBitMap=xe DMA=false
echo "BOX_INIT_DONE"
