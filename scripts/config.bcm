# phy_long_xfi_21..44 УБРАН (24.10): драйвер 84740 ставит serdes в CR при ЛЮБОЙ скорости,
# и на 1G Warpcore не ловил синхро с PHY (медный SFP: линк есть, данных нет).
# Хотплаг 1G->10G он не лечил — это делает xfifix в SFPScan.
# PHY-адреса 17-48 = как у стока (config show 24.10): логический порт N = клетка N
# (клетки 17-48 = phys N+4). Прежняя таблица была сдвинута на квад: PHY клетки N
# сидел на чужой линии Warpcore -> линк виден, данные не ходят.
# Убирает конфликт 0x44 с QSFP xe49.
# Стоковые дельты (2026-10-17, реверс netdevd): порог счётчика oversize =
# джамбо (MTU и так 16356);
# доля общего буфера MMU для multicast-очередей 0.5 (сток) — шторм
# меньше отъедает у unicast.
bcm_stat_jumbo=16348
buf.mqueue.pool_scale=0.5
# Флейк init (пойман 23.10 стеками gdb): init misc -> clear_all_memory -> mem_slam ждал
# IRQ TSLAM_DONE; если IRQ терялся, каждая очистка ждала 1с таймаута -> init >90с.
# Решение: опрос флага DONE вместо IRQ (slam и table DMA).
tslam_intr_enable=0
tdma_intr_enable=0
# Как у стока: один module id на все 64 порта. Без него порты >=32 = modid 1 (dual-modid),
# и l3table/egress требуют MOdule=1 Port=N-32 вместо xeN.
module_64ports=1
