#!/bin/sh
# === ЗАПУСКАЕТСЯ НА КОРОБКЕ: /var/bcm/sw (busybox sh/awk) ===
# Человеческий CLI к нашему свитчу: номера клеток панели вместо xeN, без ручного FIFO.
#
#   sw ports              клетки: линк, скорость, autoneg
#   sw counters <клетка>  ненулевые счётчики порта (show c)
#   sw vlan               vlan.conf + что реально стоит в чипе (vlan show)
#   sw vlan apply         vlan.conf -> vlan.soc -> rcload на живом свитче (без ребута)
#   sw sfp [клетка]       EEPROM SFP (SFPScan dump): тип модуля, DAC/оптика
#   sw raw <diag-команда> любая diag-команда BCM, ответ — в stdout
#
# Карта клетка <-> порт (24.10, как у стока): клетка N = xe(N-1) для 1-48, Q1-Q4 = xe48-51.

BCM=${BCM:-/var/bcm}
FIFO=${FIFO:-/tmp/bcm.fifo}
LOG=${LOG:-/tmp/bcmrun.log}
TIMEOUT=${TIMEOUT:-10}

die() { echo "sw: $*" >&2; exit 1; }

cage2xe() {   # $1 = клетка -> xeN (или пусто)
    case "$1" in
        [Qq][1-4]) echo "xe$((47 + ${1#?}))" ;;
        *[!0-9]*|'') ;;
        *) [ "$1" -ge 1 ] && [ "$1" -le 48 ] && echo "xe$(($1 - 1))" ;;
    esac
}

# awk-функция xe -> клетка, для вывода
XE2CAGE='function cage(x) { x += 0; if (x <= 47) return x + 1; return "Q" (x - 47) }'

# bcm <команда...>: отправить в bcm.user, дождаться ответа, напечатать его (без эха и \r)
bcm() {
    { [ -n "$SW_TEST" ] || pidof bcm.user >/dev/null 2>&1; } && [ -p "$FIFO" ] || die "bcm.user не запущен (нет $FIFO)"
    id="SW$$$(date +%s)"
    start=$(wc -l < "$LOG")
    { echo "echo =${id}=B"; for c in "$@"; do echo "$c"; done; echo "echo =${id}=E"; } > "$FIFO"
    t=0
    while ! tail -n +"$start" "$LOG" | grep -q "^=${id}=E"; do
        t=$((t + 1)); [ "$t" -gt $((TIMEOUT * 5)) ] && die "нет ответа от bcm.user за ${TIMEOUT}s"
        usleep 200000 2>/dev/null || sleep 1
    done
    tail -n +"$start" "$LOG" | tr -d '\r' | awk -v b="=${id}=B" -v e="=${id}=E" '
        $0 == b { on = 1; next }  $0 == e { exit }
        on && !/^BCM\.0> / && !/^SFPScan( xe0-xe47)?: 0 port/ { print }'
}

cmd_ports() {
    bcm ps | awk "$XE2CAGE"'
        $1 ~ /^xe[0-9]+$/ { n = substr($1, 3); st[n] = $2; sp[n] = $3; an[n] = $6; have[n] = 1 }
        END {
            printf "%-6s %-6s %-6s %-5s %s\n", "клетка", "порт", "линк", "скор", "an"
            for (i = 0; i <= 51; i++) if (i in have) row(i)
        }
        function row(i) { printf "%-6s %-6s %-6s %-5s %s\n", cage(i), "xe" i, st[i], sp[i], an[i] }'
}

cmd_counters() {
    [ -n "$1" ] || die "использование: sw counters <клетка>"
    x=$(cage2xe "$1"); [ -n "$x" ] || die "нет клетки $1"
    echo "клетка $1 = $x"
    bcm "show c $x"
}

cmd_vlan() {
    case "$1" in
        apply)
            sh "$BCM/vlan-gen.sh" "$BCM/vlan.conf" > "$BCM/vlan.soc.new" || die "vlan.conf с ошибкой, ничего не применено"
            mv "$BCM/vlan.soc.new" "$BCM/vlan.soc"
            bcm "rcload $BCM/vlan.soc" >/dev/null
            echo "применено: $(grep -c '^vlan create' "$BCM/vlan.soc") VLAN кроме 1" ;;
        '')
            echo "--- $BCM/vlan.conf:"; grep -v '^[[:space:]]*\(#\|$\)' "$BCM/vlan.conf" 2>/dev/null || echo "(пусто: всё в VLAN 1)"
            echo "--- в чипе:"; bcm "vlan show" ;;
        *) die "использование: sw vlan [apply]" ;;
    esac
}

cmd_sfp() {
    if [ -n "$1" ]; then
        x=$(cage2xe "$1"); [ -n "$x" ] || die "нет клетки $1"
        bcm "SFPScan $x dump"
    else
        bcm "SFPScan xe0-xe47 dump" "SFPScan xe48-xe51 dump"
    fi | awk "$XE2CAGE"'
        /^SFPScan xe[0-9]+:/ { split($2, a, ":"); x = substr(a[1], 3); sub(/^SFPScan xe[0-9]+:/, "клетка " cage(x) " (xe" x "):") }
        { print }'
}

case "$1" in
    ports)    cmd_ports ;;
    counters) shift; cmd_counters "$@" ;;
    vlan)     shift; cmd_vlan "$@" ;;
    sfp)      shift; cmd_sfp "$@" ;;
    raw)      shift; [ -n "$*" ] || die "использование: sw raw <diag-команда>"; bcm "$*" ;;
    *)        sed -n '4,11p' "$0" | sed 's/^# \{0,1\}//' ; exit 1 ;;
esac
