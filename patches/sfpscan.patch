# SFPScan diag command — SDK patch (sdk-xgs-robo-6.3.2, gto-2_6)
# Adds 'SFPScan [pbmp] [dump]' diag command: reads SFP EEPROM (SFF-8472, I2C 0x50)
# via BCM84740/84754 PHY I2C master (phy_84740_i2cdev_read) and auto-sets port speed.
# Generated 2026-10-04T20:27:33Z

################## diff: src/appl/diag/port.c ##################
--- src/appl/diag/port.c.orig	2026-10-04 22:04:10.031339308 +0300
+++ src/appl/diag/port.c	2026-10-04 23:19:58.022409516 +0300
@@ -10877,3 +10877,105 @@
 }
 
 #endif
+
+/* ======================================================================
+ * SFPScan  (custom, Gigamon TA100 project):
+ *   Read each SFP module's EEPROM (SFF-8472, I2C addr 0x50) through the
+ *   BCM84740/84754 PHY's on-chip I2C master, decode 10G vs 1G, and set the
+ *   port speed/autoneg automatically. Replaces the hardcoded rc.soc
+ *   "port xeN sp=10000 an=off" forcing so 10G links come up by themselves.
+ *   Usage: SFPScan [pbmp] [dump]
+ * ====================================================================== */
+extern int phy_84740_i2cdev_read(int unit, soc_port_t port, int dev_addr,
+                                 int offset, int nbytes, uint8 *read_array);
+
+char cmd_sfpscan_usage[] =
+    "SFPScan [PortBitMap] [dump]\n"
+    "\tRead SFP EEPROM (I2C 0x50) via 84740/84754 PHY and auto-set speed:\n"
+    "\t10G for 10GbE/DAC modules, 1G for 1000BASE modules. Ports already at\n"
+    "\tthe target speed are left untouched. Default pbmp = all ether ports.\n"
+    "\t'dump' also prints key EEPROM bytes (id/b3/b6/b8/b12).\n";
+
+cmd_result_t
+cmd_sfpscan(int unit, args_t *a)
+{
+    soc_pbmp_t pbm;
+    soc_port_t port;
+    char *c;
+    int dump = 0;
+    uint8 ee[16];
+    int rv, done = 0;
+
+    if (!sh_check_attached(ARG_CMD(a), unit)) {
+        return CMD_FAIL;
+    }
+
+    SOC_PBMP_ASSIGN(pbm, PBMP_E_ALL(unit));
+    while ((c = ARG_GET(a)) != NULL) {
+        if (sal_strcasecmp(c, "dump") == 0) {
+            dump = 1;
+        } else if (parse_bcm_pbmp(unit, c, &pbm) < 0) {
+            printk("%s: ERROR: unrecognized port bitmap: %s\n", ARG_CMD(a), c);
+            return CMD_FAIL;
+        }
+    }
+
+    SOC_PBMP_ITER(pbm, port) {
+        int id, b3, b6, b8, b12, want = 0, an = 0, cur = 0;
+
+        /* Clear buffer first: phy_84740_i2cdev_read() returns SOC_E_NONE even
+         * when the I2C transaction does NOT complete (no module / NAK), and in
+         * that case leaves the buffer UNTOUCHED. Pre-fill with 0xff so an empty
+         * port is detectable (id stays 0xff) instead of aliasing the previous
+         * port's EEPROM contents. */
+        sal_memset(ee, 0xff, sizeof(ee));
+        rv = phy_84740_i2cdev_read(unit, port, 0x50, 0, 13, ee);
+        if (rv < 0) {
+            continue;               /* register-access error on this port */
+        }
+        id = ee[0]; b3 = ee[3]; b6 = ee[6]; b8 = ee[8]; b12 = ee[12];
+
+        if (id == 0xff || id == 0x00) {
+            continue;               /* no module present (read did not complete) */
+        }
+
+        if (dump) {
+            printk("SFPScan %s: id=0x%02x b3(10G)=0x%02x b6(1G)=0x%02x "
+                   "b8(cbl)=0x%02x b12(rate)=0x%02x\n",
+                   SOC_PORT_NAME(unit, port), id, b3, b6, b8, b12);
+        }
+
+        if (id != 0x03) {           /* 0x03=SFP/SFP+; QSFP(40G)=0x0c/0x0d */
+            continue;
+        }
+
+        if ((b3 & 0xf0) || (b8 & 0x0c) || (b12 >= 0x40)) {
+            want = 10000; an = 0;   /* 10G SR/LR/LRM/ER or DAC cable */
+        } else if (b6 & 0x08) {
+            want = 1000;  an = 1;   /* 1000BASE-T copper -> autoneg */
+        } else if (b6 & 0x07) {
+            want = 1000;  an = 0;   /* 1000BASE-SX/LX/CX fiber -> forced */
+        } else if (b12 >= 0x0a && b12 <= 0x1e) {
+            want = 1000;  an = 0;   /* ~1-3 Gbd fallback */
+        } else {
+            printk("SFPScan %s: unknown SFP (b3=%02x b6=%02x b8=%02x b12=%02x),"
+                   " left as-is\n", SOC_PORT_NAME(unit, port), b3, b6, b8, b12);
+            continue;
+        }
+
+        (void)bcm_port_speed_get(unit, port, &cur);
+        if (cur == want) {
+            continue;               /* already correct; don't bounce link */
+        }
+
+        rv = bcm_port_autoneg_set(unit, port, an);
+        if (!an) {
+            rv |= bcm_port_speed_set(unit, port, want);
+        }
+        printk("SFPScan %s: SFP -> %dG an=%d (was %dG) rv=%d\n",
+               SOC_PORT_NAME(unit, port), want / 1000, an, cur / 1000, rv);
+        done++;
+    }
+    printk("SFPScan: %d port(s) reconfigured.\n", done);
+    return CMD_OK;
+}

